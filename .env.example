# Copy to .env and fill in. Never commit the filled version.
POSTGRES_DB=yopay
POSTGRES_USER=yopay
POSTGRES_PASSWORD=change-me-locally
ConnectionStrings__Postgres=Host=localhost;Port=5433;Database=yopay;Username=yopay;Password=change-me-locally

# Secret vault. Generate each key with: openssl rand -base64 32
# Keep the previous key on the ring until the re-encryption sweep reports zero.
Security__ActiveKeyId=k1
Security__Keys__k1=replace-me-with-32-random-bytes-base64

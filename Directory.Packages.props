<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Persistence. If NuGet reports a newer 10.0.x patch, bump all three together. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />

    <!-- IHttpClientFactory. The webhook dispatcher in T9 needs handler rotation and,
         later, Polly retry policies, both of which hang off the factory. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />

    <!-- Pulled in transitively, and audited as vulnerable at 9.0.0. Central transitive
         pinning is enabled above, so naming the package here forces the patched version
         everywhere without adding a direct reference anyone has to remember to keep.
         10.0.10 is the first release clear of the eight advisories NuGet audit raises
         against this package. Delete the line once the package dragging it in ships a
         fixed dependency of its own. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />

    <!-- Testing -->
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
  </ItemGroup>
</Project>
